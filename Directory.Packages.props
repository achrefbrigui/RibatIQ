<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="CLI">
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
  </ItemGroup>
  <ItemGroup Label="Analysis">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
  <ItemGroup Label="LLM providers">
    <PackageVersion Include="Anthropic" Version="13.12.0" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
