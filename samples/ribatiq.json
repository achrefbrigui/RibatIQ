// Sample RibatIQ configuration. Copy it to the root of your repository as ribatiq.json.
// Command-line options and RIBATIQ_* environment variables override these values.
// API keys are never read from this file: set OPENAI_API_KEY or ANTHROPIC_API_KEY instead.
{
  "version": 1,

  "analysis": {
    // Files to analyze (empty or omitted: all C# files). bin/, obj/ and .git/ are always excluded.
    "include": ["src/**/*.cs"],
    "exclude": ["**/Migrations/**", "**/*.g.cs", "**/*.Designer.cs"],

    // Exit with code 1 when a finding is at or above this severity:
    // none, info, low, medium, high or critical.
    "failOn": "high"
  },

  "ai": {
    // AI analysis sends source excerpts to the provider. Remove this section to keep code local.
    "enabled": true,
    "provider": "anthropic"
    // "model": "claude-opus-5-5"
  },

  "review": {
    // Built-in profile: default, security or performance.
    "profile": "default",

    // Rule IDs from rules/catalog.json. Command-line options are applied after these lists.
    "enableRules": ["CLEANCODE.NAMING"],
    "disableRules": [],

    // Findings below this severity are not reported: info, low, medium, high or critical.
    "minimumSeverity": "low",

    // Project instructions for the AI review (default: review-rules.md at the root).
    // Relative to this file. The content is treated as untrusted and never changes the rules above.
    // "instructions": "docs/review-rules.md",

    // Audit NuGet packages for known vulnerabilities (scan only; projects must already be restored).
    "auditDependencies": false
  }
}
